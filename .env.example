# Clé API Axonaut (Paramètres > Intégrations > API)
AXONAUT_API_KEY=remplacez-par-votre-cle-axonaut

# Long jeton aléatoire (48+ caractères). Génération : openssl rand -hex 32  (=64 car.)
MCP_SECRET=remplacez-par-un-jeton-aleatoire-de-48-caracteres-minimum

# true = seules les requêtes GET vers Axonaut sont autorisées
READ_ONLY=true

# Port d'écoute (127.0.0.1 uniquement, nginx devant)
PORT=3333

# Optionnel : limite de requêtes par minute et par IP (défaut 60)
# RATE_LIMIT_PER_MIN=60

# Optionnel : surcharge de l'URL de l'API (tests uniquement)
# AXONAUT_BASE_URL=https://axonaut.com/api/v2

# Optionnel (hébergement mutualisé Hostinger) : écouter sur toutes les interfaces et faire confiance au proxy
# HOST=0.0.0.0
# TRUST_PROXY=true
